# ── Server ─────────────────────────────────────────────────
# Get your free API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
PORT=3001
CLIENT_URL=http://localhost:5173

# Steam Web API key (free, register at https://steamcommunity.com/dev/apikey)
# Required for catalogue-based price change detection
STEAM_API_KEY=your_steam_api_key_here

# Price collector background interval in hours (default: 24)
PRICE_CHECK_INTERVAL_HOURS=24

# ── Database ───────────────────────────────────────────────
# PostgreSQL connection string.
# For local development: postgresql://user:password@localhost:5432/steamlens
# For managed services (Supabase/Neon/Render): Use the connection string they provide
DATABASE_URL=postgresql://user:password@localhost:5432/steamlens

# ── Client ─────────────────────────────────────────────────
# Create a .env file in the client/ folder with:
# VITE_API_URL=http://localhost:3001

