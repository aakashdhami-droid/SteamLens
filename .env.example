# ── PostgreSQL Database ─────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=steamlens

# ── Backend Configuration ───────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost
PRICE_CHECK_INTERVAL_HOURS=24

# JWT secret for user authentication (use a random string in production)
JWT_SECRET=your_jwt_secret_here

# ── External API Keys ─────────────────────────────────────────
# Get your free Groq API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Steam Web API key (free, register at https://steamcommunity.com/dev/apikey)
# Required for catalogue-based price change detection
STEAM_API_KEY=your_steam_api_key_here

# ── Database Connection URL ─────────────────────────────────
# For Docker Compose: postgresql://postgres:your_postgres_password_here@postgres:5432/steamlens
# For Local Dev without Docker: postgresql://postgres:your_postgres_password_here@localhost:5432/steamlens
DATABASE_URL=postgresql://postgres:your_postgres_password_here@postgres:5432/steamlens
